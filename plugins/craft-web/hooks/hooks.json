{
  "description": "craft-web: verificación determinista (WEB-*) mientras el agente trabaja en un sitio Astro.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/web_hooks.py\" post-edit",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/web_hooks.py\" stop",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
