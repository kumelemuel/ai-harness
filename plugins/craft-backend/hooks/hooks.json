{
  "description": "craft-backend: verificación determinista de la arquitectura (VER-1) mientras el agente trabaja.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/craft_hooks.py\" post-edit",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/craft_hooks.py\" stop",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
